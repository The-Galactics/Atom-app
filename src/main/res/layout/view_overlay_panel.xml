<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_m">

    <!-- Grabber handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_s"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wordmark"
            android:textAppearance="@style/TextAppearance.Atom.Wordmark" />

        <ImageButton
            android:id="@+id/overlay_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ripple_borderless"
            android:contentDescription="@string/cd_close"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="@color/on_surface_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/sub_status_tap_mic"
        android:textAppearance="@style/TextAppearance.Atom.Caption" />

    <!-- Pill input row -->
    <LinearLayout
        android:id="@+id/overlay_input_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/bg_pill_input"
        android:gravity="center_vertical"
        android:minHeight="@dimen/input_bar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <ImageButton
            android:id="@+id/overlay_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_borderless"
            android:contentDescription="@string/cd_mic"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic"
            app:tint="@color/accent" />

        <EditText
            android:id="@+id/overlay_edit_text"
            style="@style/Widget.Atom.Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/overlay_panel_hint"
            android:imeOptions="actionSend"
            android:maxLines="3"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="@dimen/space_s" />

        <ImageButton
            android:id="@+id/overlay_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/space_xs"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/cd_send"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            app:tint="@color/on_accent" />
    </LinearLayout>

</LinearLayout>
