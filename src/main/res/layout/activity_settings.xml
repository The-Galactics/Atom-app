<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_onyx"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <ImageButton
        android:id="@+id/btn_back"
        style="@style/Widget.Atom.IconButton.Ghost"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_s"
        android:contentDescription="@string/cd_back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textAppearance="@style/TextAppearance.Atom.Title"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        app:layout_constraintBottom_toTopOf="@+id/btn_save"
        app:layout_constraintTop_toBottomOf="@+id/btn_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_profile"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_your_name"
                android:textAppearance="@style/TextAppearance.Atom.Caption" />

            <EditText
                android:id="@+id/et_user_name"
                style="@style/Widget.Atom.Input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_bar_height"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card_input"
                android:hint="@string/settings_your_name_hint"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/space_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_assistant_name"
                android:textAppearance="@style/TextAppearance.Atom.Caption" />

            <EditText
                android:id="@+id/et_ai_name"
                style="@style/Widget.Atom.Input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_bar_height"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card_input"
                android:hint="@string/settings_assistant_name_hint"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/space_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_voice_output"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_surface_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_tts_toggle"
                    android:textAppearance="@style/TextAppearance.Atom.Label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_tts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_tts_toggle" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_tts_voice"
                android:textAppearance="@style/TextAppearance.Atom.Caption" />

            <Spinner
                android:id="@+id/spinner_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_surface_card"
                android:padding="@dimen/space_s"
                android:contentDescription="@string/settings_tts_voice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preview_voice"
                style="@style/Widget.Atom.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_bar_height"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_tts_preview" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_tts_speed"
                android:textAppearance="@style/TextAppearance.Atom.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seekbar_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_s"
                    android:max="100"
                    android:progressDrawable="@drawable/volume_track"
                    android:thumb="@drawable/volume_thumb"
                    android:splitTrack="false"
                    android:contentDescription="@string/settings_tts_speed" />

                <TextView
                    android:id="@+id/tv_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.9x"
                    android:textAppearance="@style/TextAppearance.Atom.Caption" />
            </LinearLayout>

            <!-- Permission dashboard: live status + one-tap fix for the three
                 capabilities Atom relies on. Status chips refresh in onResume. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_permissions"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <!-- Overlay row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_overlay"
                            android:textAppearance="@style/TextAppearance.Atom.Label" />

                        <TextView
                            android:id="@+id/chip_overlay_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Atom.Overline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_overlay"
                        style="@style/Widget.Atom.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_perm_fix"
                        android:contentDescription="@string/cd_fix_overlay" />
                </LinearLayout>

                <!-- Accessibility row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_accessibility"
                            android:textAppearance="@style/TextAppearance.Atom.Label" />

                        <TextView
                            android:id="@+id/chip_accessibility_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Atom.Overline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_accessibility"
                        style="@style/Widget.Atom.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_perm_fix"
                        android:contentDescription="@string/cd_fix_accessibility" />
                </LinearLayout>

                <!-- Microphone row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_microphone"
                            android:textAppearance="@style/TextAppearance.Atom.Label" />

                        <TextView
                            android:id="@+id/chip_microphone_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Atom.Overline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_microphone"
                        style="@style/Widget.Atom.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_perm_fix"
                        android:contentDescription="@string/cd_fix_microphone" />
                </LinearLayout>

                <!-- Notifications row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_notifications"
                            android:textAppearance="@style/TextAppearance.Atom.Label" />

                        <TextView
                            android:id="@+id/chip_notifications_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Atom.Overline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_notifications"
                        style="@style/Widget.Atom.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_perm_fix"
                        android:contentDescription="@string/cd_fix_notifications" />
                </LinearLayout>

                <!-- Battery row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_battery"
                            android:textAppearance="@style/TextAppearance.Atom.Label" />

                        <TextView
                            android:id="@+id/chip_battery_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Atom.Overline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_battery"
                        style="@style/Widget.Atom.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_perm_fix"
                        android:contentDescription="@string/cd_fix_battery" />
                </LinearLayout>

                <!-- Autostart row (hidden on skins without an autostart concept) -->
                <LinearLayout
                    android:id="@+id/row_autostart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_autostart"
                            android:textAppearance="@style/TextAppearance.Atom.Label" />

                        <TextView
                            android:id="@+id/chip_autostart_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Atom.Overline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fix_autostart"
                        style="@style/Widget.Atom.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/permsetup_done"
                        android:contentDescription="@string/cd_fix_autostart" />
                </LinearLayout>
            </LinearLayout>

            <!-- Wake word section: enable + battery-saver toggle. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_wake_word"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_wake_enable"
                        android:textAppearance="@style/TextAppearance.Atom.Label" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_wake_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_wake_enable" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/label_wake_screen_on"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_wake_screen_on"
                        android:textAppearance="@style/TextAppearance.Atom.Label" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_wake_screen_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_wake_screen_on" />
                </LinearLayout>
            </LinearLayout>

            <!-- Language section: System default / English / Español. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_language"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <Spinner
                android:id="@+id/spinner_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_surface_card"
                android:padding="@dimen/space_s"
                android:contentDescription="@string/settings_language" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_assistant_access"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_assistant_access_desc"
                    android:textAppearance="@style/TextAppearance.Atom.Caption" />

                <TextView
                    android:id="@+id/tv_bubble_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Atom.Overline"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_bubble"
                    style="@style/Widget.Atom.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_bar_height"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/settings_enable_bubble"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_membership"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <!-- Free Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_surface_card"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_plan_free"
                        android:textAppearance="@style/TextAppearance.Atom.Label" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/settings_plan_free_desc"
                        android:textAppearance="@style/TextAppearance.Atom.Caption" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_plan_free_price"
                    android:textAppearance="@style/TextAppearance.Atom.Label" />
            </LinearLayout>

            <!-- Pro Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_surface_card"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_plan_pro"
                        android:textAppearance="@style/TextAppearance.Atom.Label" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/settings_plan_pro_desc"
                        android:textAppearance="@style/TextAppearance.Atom.Caption" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_plan_pro_price"
                    android:textAppearance="@style/TextAppearance.Atom.Label" />
            </LinearLayout>

            <!-- Account section: logout -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_account"
                android:textAppearance="@style/TextAppearance.Atom.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.Atom.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_bar_height"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/auth_logout" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/Widget.Atom.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_bar_height"
        android:layout_margin="@dimen/space_l"
        android:text="@string/settings_save"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
