<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security policy for Atom (US-10.4 + dev cleartext scoping).

    1) Certificate pinning for the production backend (atom.crudzaso.com). The
       app's gRPC client uses the platform TLS stack, so Android enforces this
       <pin-set> on the gRPC/TLS handshake: a man-in-the-middle presenting a
       different certificate chain (even via a malicious root CA installed on the
       device) fails the handshake and the connection is aborted.

       Pins are the SHA-256 of the SubjectPublicKeyInfo (SPKI), base64. We pin the
       leaf + intermediate + ISRG root, so a Let's Encrypt renewal (new leaf, same
       chain) does NOT break installed apps — any one matching pin in the chain
       passes.

       SAFETY VALVE: `expiration` makes pinning LAPSE (fall back to standard CA
       validation) after the date instead of bricking the published app if the
       pins are ever left stale. ALWAYS re-extract the pins and bump `expiration`
       well before it passes. Re-extract with:
         openssl s_client -connect atom.crudzaso.com:443 -servername atom.crudzaso.com </dev/null \
           | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der \
           | openssl dgst -sha256 -binary | openssl base64

    2) Cleartext (non-TLS) is permitted ONLY for local dev loopback hosts. Any
       REMOTE host must use TLS; the gRPC client only falls back to usePlaintext()
       for these loopback hosts in debug builds.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">atom.crudzaso.com</domain>
        <pin-set expiration="2027-06-25">
            <!-- leaf: CN=atom.crudzaso.com -->
            <pin digest="SHA-256">2gqbVZ9vB8JQmvRklO7adAB9cRGlUkBi0RugkY1xrSY=</pin>
            <!-- intermediate: O=Let's Encrypt, CN=YE1 -->
            <pin digest="SHA-256">brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4=</pin>
            <!-- root: O=ISRG, CN=Root YE -->
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
        </pin-set>
    </domain-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
