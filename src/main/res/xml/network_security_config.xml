<?xml version="1.0" encoding="utf-8"?>
<!--
    Permits cleartext (plaintext, non-TLS) traffic ONLY for the local dev backend
    hosts used during development. The Python Atom-agent serves gRPC over an
    insecure/plaintext channel on :50051, and the app's gRPC client uses
    ManagedChannelBuilder.usePlaintext(), which respects Android's
    NetworkSecurityPolicy.

    Scoped on purpose: a blanket android:usesCleartextTraffic="true" would disable
    cleartext protection app-wide. Production hosts must use TLS.

      - 10.0.2.2 : emulator alias to the host machine's localhost.
      - localhost / 127.0.0.1 : on-device loopback / direct runs.
      - 167.233.32.146 : VPS backend (plaintext gRPC, dev only — no TLS yet).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">167.233.32.146</domain>
    </domain-config>
</network-security-config>
