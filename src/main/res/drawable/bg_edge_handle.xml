<?xml version="1.0" encoding="utf-8"?>
<!-- Game Turbo style edge line, white to match the Atom logo. The outer item is a soft
     white glow; the inner item is the solid white core line. Pinned flush to the screen
     border by FloatingBubbleService. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
