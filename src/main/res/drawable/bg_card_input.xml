<?xml version="1.0" encoding="utf-8"?>
<!-- Card-shaped input that lights up on focus: accent stroke over a faint accent
     wash, mirroring bg_pill_input but at radius_card. Resting matches bg_surface_card. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_2" />
                    <corners android:radius="@dimen/radius_card" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_glow_soft" />
                    <corners android:radius="@dimen/radius_card" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_2" />
                    <corners android:radius="@dimen/radius_card" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_glow_soft" />
                    <corners android:radius="@dimen/radius_card" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_1" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
        </shape>
    </item>
</selector>
