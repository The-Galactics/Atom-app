<?xml version="1.0" encoding="utf-8"?>
<!-- User chat bubble: filled accent, with the bottom-end corner tightened so it
     reads as anchored to the right (the sender side). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/accent" />
    <corners
        android:topLeftRadius="@dimen/radius_card"
        android:topRightRadius="@dimen/radius_card"
        android:bottomLeftRadius="@dimen/radius_card"
        android:bottomRightRadius="@dimen/space_xs" />
</shape>
