<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused / active: accent border, slightly raised surface. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
        </shape>
    </item>

    <!-- Resting: hairline border on surface_1. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_1" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
        </shape>
    </item>

</selector>
